<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- For VS <= 2019 -->
    <TargetFrameworks Condition="'$(MSBuildVersion)' &lt; '17.0'">netstandard2.0</TargetFrameworks>
    <!-- For VS >= 2022 -->
    <TargetFrameworks Condition="'$(MSBuildVersion)' &gt;= '17.0'">netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>PolyglotSql</RootNamespace>
    <AssemblyName>PolyglotSql.Core</AssemblyName>

    <PackageId>PolyglotSql.Core</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>A .NET FFI wrapper for the Polyglot Rust SQL transpiler. Parsing, formatting, AST generation, and translation between 30+ SQL dialects. Use the Core package with your own Polyglot native library.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PolyglotSql.Tests" />
    <InternalsVisibleTo Include="PolyglotSql.Bundle" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>