<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- Copy runtimes folder only for legacy netframework -->
    <ItemGroup Condition="('$(TargetFrameworkVersion)' != '' And $(TargetFrameworkVersion.StartsWith('v4'))) Or ('$(TargetFramework)' != '' And $(TargetFramework.StartsWith('net4')))">

        <!-- Inside NuGet package this .targets sits in build/, 
         but runtimes folder is level up in the package root -->
        <_PolyglotPackageFiles Include="$(MSBuildThisFileDirectory)..\runtimes\**\*" />

        <Content Include="@(_PolyglotPackageFiles)">
            <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <PublishState>Included</PublishState>
            <Visible>False</Visible>
            <Pack>false</Pack>
        </Content>
    </ItemGroup>
</Project>