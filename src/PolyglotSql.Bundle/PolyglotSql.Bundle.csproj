<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolyglotSql.Core\PolyglotSql.Core.csproj" />
  </ItemGroup>

  <!-- for PackageReference -->
  <ItemGroup>
    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes\" />
    <None Include="PolyglotSql.Bundle.targets" Pack="true" PackagePath="build\YourLib.Bundle.targets" />
  </ItemGroup>

  <!-- for ProjectReference -->
  <Import Project="PolyglotSql.Bundle.targets" />
</Project>
